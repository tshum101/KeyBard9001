{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "Bootloader: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "deviceName": "STM32F407VGT6",
            "deviceCore": "Cortex-M4",
            "verbose": true,
            "serverCubeProgPath": "${command:st-stm32-ide-debug-launch.get-programmer-path}",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/Bootloader.elf"
                }
            ]
        }
    ]
}
